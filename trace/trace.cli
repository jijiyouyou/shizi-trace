# trace.cli — 合并 mau_trace + iparser_trace + eparser_pe_trace
# 用法:
#   trace.cli ipp <die> <pp0|pp1> epp <die> <pp0|pp1>
# 例:
#   trace.cli ipp xdie pp0 epp sdie8 pp1
# 行为:
#   ipp: mau0..mau8 + iparser
#   epp: mau9..mau10 + eparser + pedt
# die: xdie | sdie0..sdie8

echo $1
echo $2
echo $3
echo $4
echo $5
echo $6

local run_ipp 0
local run_epp 0
case $1 ipp "local run_ipp 1; echo arg1=ipp" * "echo ERROR: arg1 must be ipp; local run_ipp 0"
case $4 epp "local run_epp 1; echo arg4=epp" * "echo ERROR: arg4 must be epp; local run_epp 0"

# ======================== IPP: mau0-8 + iparser ========================
echo ---- ipp start ----
local die $2
local pipe $3
local ok 0
local mau_lo 0
local mau_hi -1
local pp 0
local uniq 0x90
local ip_hi -1
case $run_ipp 0 "echo skip ipp section; local ok 0; local mau_hi -1; local ip_hi -1"
case $run_ipp 1 "case $pipe pp0 'local pp 0; local mau_lo 0; local mau_hi 8; echo ipp pipe=pp0' pp1 'local pp 1; local mau_lo 0; local mau_hi 8; echo ipp pipe=pp1' * 'echo ERROR: arg3 must be pp0 or pp1; local mau_hi -1'"

case $die xdie "local uniq 0x90; local ok 1" sdie8 "case $pipe pp0 'local uniq 0x80; local ok 1' pp1 'local uniq 0x81; local ok 1'" sdie0 "case $pipe pp0 'local uniq 0x00; local ok 1' pp1 'local uniq 0x01; local ok 1'" sdie1 "case $pipe pp0 'local uniq 0x10; local ok 1' pp1 'local uniq 0x11; local ok 1'" sdie2 "case $pipe pp0 'local uniq 0x20; local ok 1' pp1 'local uniq 0x21; local ok 1'" sdie3 "case $pipe pp0 'local uniq 0x30; local ok 1' pp1 'local uniq 0x31; local ok 1'" sdie4 "case $pipe pp0 'local uniq 0x40; local ok 1' pp1 'local uniq 0x41; local ok 1'" sdie5 "case $pipe pp0 'local uniq 0x50; local ok 1' pp1 'local uniq 0x51; local ok 1'" sdie6 "case $pipe pp0 'local uniq 0x60; local ok 1' pp1 'local uniq 0x61; local ok 1'" sdie7 "case $pipe pp0 'local uniq 0x70; local ok 1' pp1 'local uniq 0x71; local ok 1'" * "echo ERROR: arg2 must be xdie or sdie0..sdie8; local ok 0"
case $run_ipp 0 "local ok 0; local mau_hi -1; local ip_hi -1"
case $ok 0 "echo ipp aborted; local mau_hi -1; local ip_hi -1"
case $ok 1 "echo ipp mau=${mau_lo}..${mau_hi} uniq=$uniq"
echo "ipp: die=$die pipe=$pipe pp=$pp uniq=$uniq ok=$ok mau=${mau_lo}..${mau_hi} run_ipp=$run_ipp"

for mau=${mau_lo},${mau_hi} 'case $mau 0 "local begin 0x10000; local block 0x03" 1 "local begin 0x20000; local block 0x03" 2 "local begin 0x30000; local block 0x03" 3 "local begin 0x100000; local block 0x04" 4 "local begin 0x110000; local block 0x04" 5 "local begin 0x120000; local block 0x04" 6 "local begin 0x130000; local block 0x04" 7 "local begin 0x200000; local block 0x05" 8 "local begin 0x210000; local block 0x05" 9 "local begin 0x310000; local block 0x0e" 10 "local begin 0x320000; local block 0x0e"; echo ---- mau$mau start ----; expr ${begin}+0x1308; local addr $?; echo ---- cls_trace start ----; reg read ${block} ${uniq} ${addr} 18; echo ---- cls_trace end ----; expr ${begin}+0x1358; local addr $?; echo ---- keygen_trace start ----; reg read ${block} ${uniq} ${addr} 29; echo ---- keygen_trace end ----; expr ${begin}+0x13cc; local addr $?; echo ---- vme0_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme0_trace end ----; expr ${begin}+0x149c; local addr $?; echo ---- vme1_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme1_trace end ----; expr ${begin}+0x156c; local addr $?; echo ---- vme2_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme2_trace end ----; expr ${begin}+0x163c; local addr $?; echo ---- vme3_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme3_trace end ----; expr ${begin}+0x170c; local addr $?; echo ---- vme4_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme4_trace end ----; expr ${begin}+0x17dc; local addr $?; echo ---- lrr_trace start ----; reg read ${block} ${uniq} ${addr} 26; echo ---- lrr_trace end ----; expr ${begin}+0x1844; local addr $?; echo ---- egr_trace start ----; reg read ${block} ${uniq} ${addr} 54; echo ---- egr_trace end ----; echo ---- statistics start ----; expr ${begin}+0x1300; local addr $?; echo ---- trace_ctrl start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- trace_ctrl end ----; expr ${begin}+0x12c0; local addr $?; echo ---- other_cfg start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- other_cfg end ----; expr ${begin}+0x0; local addr $?; echo ---- cfg_inst start ----; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x70; local addr $?; reg read ${block} ${uniq} ${addr} 2; echo ---- cfg_inst end ----; expr ${begin}+0x6e4; local addr $?; echo ---- fw_init start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- fw_init end ----; expr ${begin}+0xd14; local addr $?; echo ---- fw_ecc start ----; reg read ${block} ${uniq} ${addr} 7; echo ---- fw_ecc end ----; expr ${begin}+0xd30; local addr $?; echo ---- fw_dbg start ----; reg read ${block} ${uniq} ${addr} 25; expr ${begin}+0xd94; local addr $?; reg read ${block} ${uniq} ${addr} 1; expr ${begin}+0xd9c; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- fw_dbg end ----; expr ${begin}+0x191c; local addr $?; echo ---- bp_stat start ----; reg read ${block} ${uniq} ${addr} 2; expr ${begin}+0x1924; local addr $?; reg read ${block} ${uniq} ${addr} 6; expr ${begin}+0x193c; local addr $?; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x1964; local addr $?; reg read ${block} ${uniq} ${addr} 2; echo ---- bp_stat end ----; expr ${begin}+0x196c; local addr $?; echo ---- fifo_thres start ----; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x1994; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- fifo_thres end ----; echo ---- statistics end ----; echo ---- mau$mau end ----'

case $ok 0 "echo skip iparser; local ip_hi -1"
case $ok 1 "echo iparser_trace run; local ip_hi 0"
for ip=0,${ip_hi} 'echo ---- iparser start ----; local begin 0x00000000; local block 0x03; expr ${begin}+0x0428; local addr $?; local len 16; echo ---- dbg_hdr_info start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_hdr_info end ----; expr ${begin}+0x0468; local addr $?; local len 16; echo ---- dbg_psv_info start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_psv_info end ----; expr ${begin}+0x04a8; local addr $?; local len 1; echo ---- dbg_ppu_out_data0 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_ppu_out_data0 end ----; expr ${begin}+0x04ac; local addr $?; local len 1; echo ---- dbg_ppu_out_data1 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_ppu_out_data1 end ----; expr ${begin}+0x04b0; local addr $?; local len 1; echo ---- dbg_eof_out_data start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_eof_out_data end ----; expr ${begin}+0x04b4; local addr $?; local len 12; echo ---- dbg_mpl_req_info start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_mpl_req_info end ----; expr ${begin}+0x04e4; local addr $?; local len 9; echo ---- dbg_mpl_rsp_info start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_mpl_rsp_info end ----; expr ${begin}+0x0508; local addr $?; local len 1; echo ---- dbg_mpl_rsp_info1 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_mpl_rsp_info1 end ----; expr ${begin}+0x050c; local addr $?; local len 6; echo ---- dbg_stg_tcam_match_rcd0 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_stg_tcam_match_rcd0 end ----; expr ${begin}+0x0524; local addr $?; local len 6; echo ---- dbg_stg_tcam_match_rcd1 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_stg_tcam_match_rcd1 end ----; expr ${begin}+0x053c; local addr $?; local len 6; echo ---- dbg_stg_tcam_match_rcd2 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_stg_tcam_match_rcd2 end ----; expr ${begin}+0x0544; local addr $?; local len 6; echo ---- dbg_stg_info_rcd start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_stg_info_rcd end ----; expr ${begin}+0x056c; local addr $?; local len 6; echo ---- dbg_stg_done_rcd start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_stg_done_rcd end ----; expr ${begin}+0x0584; local addr $?; local len 1; echo ---- dbg_exm_info0 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_exm_info0 end ----; expr ${begin}+0x0588; local addr $?; local len 1; echo ---- dbg_exm_info1 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_exm_info1 end ----; expr ${begin}+0x058c; local addr $?; local len 1; echo ---- dbg_pstproc_check start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_pstproc_check end ----; expr ${begin}+0x0590; local addr $?; local len 1; echo ---- dbg_pstproc_dptr_rcd0 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_pstproc_dptr_rcd0 end ----; expr ${begin}+0x0594; local addr $?; local len 1; echo ---- dbg_pstproc_dptr_rcd1 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_pstproc_dptr_rcd1 end ----; expr ${begin}+0x0598; local addr $?; local len 1; echo ---- dbg_pstproc_dptr_rcd2 start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_pstproc_dptr_rcd2 end ----; expr ${begin}+0x059c; local addr $?; local len 16; echo ---- dbg_ctn_info start ----; reg read ${block} ${uniq} ${addr} ${len}; echo ---- dbg_ctn_info end ----; echo ---- iparser end ----'
echo ---- ipp end ----

# ======================== EPP: mau9-10 + eparser + pedt ========================
echo ---- epp start ----
local die $5
local pipe $6
local ok 0
local mau_lo 9
local mau_hi -1
local pp 0
local uniq 0x90
local ep_hi -1
local pd_hi -1
case $run_epp 0 "echo skip epp section; local ok 0; local mau_hi -1; local ep_hi -1; local pd_hi -1"
case $run_epp 1 "case $pipe pp0 'local pp 0; local mau_lo 9; local mau_hi 10; local ep_hi 0; local pd_hi 1; echo epp pipe=pp0' pp1 'local pp 1; local mau_lo 9; local mau_hi 10; local ep_hi 0; local pd_hi 1; echo epp pipe=pp1' * 'echo ERROR: arg6 must be pp0 or pp1; local mau_hi -1; local ep_hi -1; local pd_hi -1'"

case $die xdie "local uniq 0x90; local ok 1" sdie8 "case $pipe pp0 'local uniq 0x80; local ok 1' pp1 'local uniq 0x81; local ok 1'" sdie0 "case $pipe pp0 'local uniq 0x00; local ok 1' pp1 'local uniq 0x01; local ok 1'" sdie1 "case $pipe pp0 'local uniq 0x10; local ok 1' pp1 'local uniq 0x11; local ok 1'" sdie2 "case $pipe pp0 'local uniq 0x20; local ok 1' pp1 'local uniq 0x21; local ok 1'" sdie3 "case $pipe pp0 'local uniq 0x30; local ok 1' pp1 'local uniq 0x31; local ok 1'" sdie4 "case $pipe pp0 'local uniq 0x40; local ok 1' pp1 'local uniq 0x41; local ok 1'" sdie5 "case $pipe pp0 'local uniq 0x50; local ok 1' pp1 'local uniq 0x51; local ok 1'" sdie6 "case $pipe pp0 'local uniq 0x60; local ok 1' pp1 'local uniq 0x61; local ok 1'" sdie7 "case $pipe pp0 'local uniq 0x70; local ok 1' pp1 'local uniq 0x71; local ok 1'" * "echo ERROR: arg5 must be xdie or sdie0..sdie8; local ok 0"
case $run_epp 0 "local ok 0; local mau_hi -1; local ep_hi -1; local pd_hi -1"
case $ok 0 "echo epp aborted; local mau_hi -1; local ep_hi -1; local pd_hi -1"
case $ok 1 "echo epp mau=${mau_lo}..${mau_hi} uniq=$uniq"
echo "epp: die=$die pipe=$pipe pp=$pp uniq=$uniq ok=$ok mau=${mau_lo}..${mau_hi} run_epp=$run_epp"

for mau=${mau_lo},${mau_hi} 'case $mau 0 "local begin 0x10000; local block 0x03" 1 "local begin 0x20000; local block 0x03" 2 "local begin 0x30000; local block 0x03" 3 "local begin 0x100000; local block 0x04" 4 "local begin 0x110000; local block 0x04" 5 "local begin 0x120000; local block 0x04" 6 "local begin 0x130000; local block 0x04" 7 "local begin 0x200000; local block 0x05" 8 "local begin 0x210000; local block 0x05" 9 "local begin 0x310000; local block 0x0e" 10 "local begin 0x320000; local block 0x0e"; echo ---- mau$mau start ----; expr ${begin}+0x1308; local addr $?; echo ---- cls_trace start ----; reg read ${block} ${uniq} ${addr} 18; echo ---- cls_trace end ----; expr ${begin}+0x1358; local addr $?; echo ---- keygen_trace start ----; reg read ${block} ${uniq} ${addr} 29; echo ---- keygen_trace end ----; expr ${begin}+0x13cc; local addr $?; echo ---- vme0_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme0_trace end ----; expr ${begin}+0x149c; local addr $?; echo ---- vme1_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme1_trace end ----; expr ${begin}+0x156c; local addr $?; echo ---- vme2_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme2_trace end ----; expr ${begin}+0x163c; local addr $?; echo ---- vme3_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme3_trace end ----; expr ${begin}+0x170c; local addr $?; echo ---- vme4_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme4_trace end ----; expr ${begin}+0x17dc; local addr $?; echo ---- lrr_trace start ----; reg read ${block} ${uniq} ${addr} 26; echo ---- lrr_trace end ----; expr ${begin}+0x1844; local addr $?; echo ---- egr_trace start ----; reg read ${block} ${uniq} ${addr} 54; echo ---- egr_trace end ----; echo ---- statistics start ----; expr ${begin}+0x1300; local addr $?; echo ---- trace_ctrl start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- trace_ctrl end ----; expr ${begin}+0x12c0; local addr $?; echo ---- other_cfg start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- other_cfg end ----; expr ${begin}+0x0; local addr $?; echo ---- cfg_inst start ----; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x70; local addr $?; reg read ${block} ${uniq} ${addr} 2; echo ---- cfg_inst end ----; expr ${begin}+0x6e4; local addr $?; echo ---- fw_init start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- fw_init end ----; expr ${begin}+0xd14; local addr $?; echo ---- fw_ecc start ----; reg read ${block} ${uniq} ${addr} 7; echo ---- fw_ecc end ----; expr ${begin}+0xd30; local addr $?; echo ---- fw_dbg start ----; reg read ${block} ${uniq} ${addr} 25; expr ${begin}+0xd94; local addr $?; reg read ${block} ${uniq} ${addr} 1; expr ${begin}+0xd9c; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- fw_dbg end ----; expr ${begin}+0x191c; local addr $?; echo ---- bp_stat start ----; reg read ${block} ${uniq} ${addr} 2; expr ${begin}+0x1924; local addr $?; reg read ${block} ${uniq} ${addr} 6; expr ${begin}+0x193c; local addr $?; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x1964; local addr $?; reg read ${block} ${uniq} ${addr} 2; echo ---- bp_stat end ----; expr ${begin}+0x196c; local addr $?; echo ---- fifo_thres start ----; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x1994; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- fifo_thres end ----; echo ---- statistics end ----; echo ---- mau$mau end ----'

case $ok 0 "echo skip eparser_pe"
case $ok 1 "echo eparser_pe_trace run"
for mod=0,${ep_hi} 'case $mod 0 "local module eparser; local begin 0x300000; local block 0x0e"; echo ====== ${module} register dump start ======; echo ---- ${module} dbg_trace_sel start ----; expr ${begin}+0x314; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- ${module} dbg_trace_sel end ----; echo ---- ${module} dbg_trace_ctrl start ----; expr ${begin}+0x318; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- ${module} dbg_trace_ctrl end ----; echo ---- ${module} dbg_trace_clr start ----; expr ${begin}+0x31c; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- ${module} dbg_trace_clr end ----; echo ---- ${module} dbg_hdr_info start ----; expr ${begin}+0x320; local addr $?; reg read ${block} ${uniq} ${addr} 16; echo ---- ${module} dbg_hdr_info end ----; echo ---- ${module} dbg_psv_info start ----; expr ${begin}+0x360; local addr $?; reg read ${block} ${uniq} ${addr} 16; echo ---- ${module} dbg_psv_info end ----; echo ---- ${module} dbg_pph_info start ----; expr ${begin}+0x3a0; local addr $?; reg read ${block} ${uniq} ${addr} 8; echo ---- ${module} dbg_pph_info end ----; echo ---- ${module} dbg_etmh_info start ----; expr ${begin}+0x3c0; local addr $?; reg read ${block} ${uniq} ${addr} 2; echo ---- ${module} dbg_etmh_info end ----; echo ---- ${module} dbg_pedt_info start ----; expr ${begin}+0x3c8; local addr $?; reg read ${block} ${uniq} ${addr} 3; echo ---- ${module} dbg_pedt_info end ----; echo ---- ${module} dbg_eof_out_info start ----; expr ${begin}+0x3d4; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- ${module} dbg_eof_out_info end ----; echo ---- ${module} dbg_mpl_req_info start ----; expr ${begin}+0x3d8; local addr $?; reg read ${block} ${uniq} ${addr} 3; echo ---- ${module} dbg_mpl_req_info end ----; echo ---- ${module} dbg_mpl_rsp_info start ----; expr ${begin}+0x3e4; local addr $?; reg read ${block} ${uniq} ${addr} 9; echo ---- ${module} dbg_mpl_rsp_info end ----; echo ---- ${module} dbg_sfr_info start ----; 