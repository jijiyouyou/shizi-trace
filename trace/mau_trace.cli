echo $1
echo $2
echo $3
local die $1
local dir $2
local pipe $3
local ok 0
local mau_lo 0
local mau_hi 8
case $dir ipp "local mau_lo 0; local mau_hi 8; echo dir=ipp" epp "local mau_lo 9; local mau_hi 10; echo dir=epp" * "echo ERROR: arg2 must be ipp or epp; local mau_hi -1"
case $pipe pp0 "local pp 0; echo pipe=pp0" pp1 "local pp 1; echo pipe=pp1" * "echo ERROR: arg3 must be pp0 or pp1; local mau_hi -1"
case $die xdie "local uniq 0x90; local ok 1" sdie8 "case $pipe pp0 'local uniq 0x80; local ok 1' pp1 'local uniq 0x81; local ok 1'" sdie0 "case $pipe pp0 'local uniq 0x00; local ok 1' pp1 'local uniq 0x01; local ok 1'" sdie1 "case $pipe pp0 'local uniq 0x10; local ok 1' pp1 'local uniq 0x11; local ok 1'" sdie2 "case $pipe pp0 'local uniq 0x20; local ok 1' pp1 'local uniq 0x21; local ok 1'" sdie3 "case $pipe pp0 'local uniq 0x30; local ok 1' pp1 'local uniq 0x31; local ok 1'" sdie4 "case $pipe pp0 'local uniq 0x40; local ok 1' pp1 'local uniq 0x41; local ok 1'" sdie5 "case $pipe pp0 'local uniq 0x50; local ok 1' pp1 'local uniq 0x51; local ok 1'" sdie6 "case $pipe pp0 'local uniq 0x60; local ok 1' pp1 'local uniq 0x61; local ok 1'" sdie7 "case $pipe pp0 'local uniq 0x70; local ok 1' pp1 'local uniq 0x71; local ok 1'" * "echo ERROR: arg1 must be xdie or sdie0..sdie8"
echo "mau_trace: die=$die dir=$dir pipe=$pipe uniq=$uniq ok=$ok mau=${mau_lo}..${mau_hi}"
case $ok 0 "echo mau_trace aborted; local mau_hi -1"
case $ok 1 "echo mau_trace run mau${mau_lo}..mau${mau_hi}"
for mau=${mau_lo},${mau_hi} 'case $mau 0 "local begin 0x10000; local block 0x03" 1 "local begin 0x20000; local block 0x03" 2 "local begin 0x30000; local block 0x03" 3 "local begin 0x100000; local block 0x04" 4 "local begin 0x110000; local block 0x04" 5 "local begin 0x120000; local block 0x04" 6 "local begin 0x130000; local block 0x04" 7 "local begin 0x200000; local block 0x05" 8 "local begin 0x210000; local block 0x05" 9 "local begin 0x310000; local block 0x0e" 10 "local begin 0x320000; local block 0x0e"; echo ---- mau$mau start ----; expr ${begin}+0x1308; local addr $?; echo ---- cls_trace start ----; reg read ${block} ${uniq} ${addr} 18; echo ---- cls_trace end ----; expr ${begin}+0x1358; local addr $?; echo ---- keygen_trace start ----; reg read ${block} ${uniq} ${addr} 29; echo ---- keygen_trace end ----; expr ${begin}+0x13cc; local addr $?; echo ---- vme0_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme0_trace end ----; expr ${begin}+0x149c; local addr $?; echo ---- vme1_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme1_trace end ----; expr ${begin}+0x156c; local addr $?; echo ---- vme2_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme2_trace end ----; expr ${begin}+0x163c; local addr $?; echo ---- vme3_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme3_trace end ----; expr ${begin}+0x170c; local addr $?; echo ---- vme4_trace start ----; reg read ${block} ${uniq} ${addr} 52; echo ---- vme4_trace end ----; expr ${begin}+0x17dc; local addr $?; echo ---- lrr_trace start ----; reg read ${block} ${uniq} ${addr} 26; echo ---- lrr_trace end ----; expr ${begin}+0x1844; local addr $?; echo ---- egr_trace start ----; reg read ${block} ${uniq} ${addr} 54; echo ---- egr_trace end ----; echo ---- statistics start ----; expr ${begin}+0x1300; local addr $?; echo ---- trace_ctrl start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- trace_ctrl end ----; expr ${begin}+0x12c0; local addr $?; echo ---- other_cfg start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- other_cfg end ----; expr ${begin}+0x0; local addr $?; echo ---- cfg_inst start ----; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x70; local addr $?; reg read ${block} ${uniq} ${addr} 2; echo ---- cfg_inst end ----; expr ${begin}+0x6e4; local addr $?; echo ---- fw_init start ----; reg read ${block} ${uniq} ${addr} 2; echo ---- fw_init end ----; expr ${begin}+0xd14; local addr $?; echo ---- fw_ecc start ----; reg read ${block} ${uniq} ${addr} 7; echo ---- fw_ecc end ----; expr ${begin}+0xd30; local addr $?; echo ---- fw_dbg start ----; reg read ${block} ${uniq} ${addr} 25; expr ${begin}+0xd94; local addr $?; reg read ${block} ${uniq} ${addr} 1; expr ${begin}+0xd9c; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- fw_dbg end ----; expr ${begin}+0x191c; local addr $?; echo ---- bp_stat start ----; reg read ${block} ${uniq} ${addr} 2; expr ${begin}+0x1924; local addr $?; reg read ${block} ${uniq} ${addr} 6; expr ${begin}+0x193c; local addr $?; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x1964; local addr $?; reg read ${block} ${uniq} ${addr} 2; echo ---- bp_stat end ----; expr ${begin}+0x196c; local addr $?; echo ---- fifo_thres start ----; reg read ${block} ${uniq} ${addr} 10; expr ${begin}+0x1994; local addr $?; reg read ${block} ${uniq} ${addr} 1; echo ---- fifo_thres end ----; echo ---- statistics end ----; echo ---- mau$mau end ----'
